# Environment configuration for the Multi-Agent AI Workflow system

# LLM Configuration
# Set LLM_MODE to "online" to use real OpenRouter API, or "offline" for mock mode
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-3.5-turbo
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODE=offline
LLM_TIMEOUT_SECONDS=30

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5433/multi_agent_db

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6380/0

# Workflow Configuration
MAX_WORKFLOW_STEPS=100
WORKFLOW_BUDGET_LIMIT_USD=10.0
WORKFLOW_TIMEOUT_SECONDS=300

# Tool Configuration
TAVILY_API_KEY=your_tavily_api_key_here
TOOL_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_DELAY_SECONDS=1

# Approval Configuration
APPROVAL_REQUIRED=true

# Logging
LOG_LEVEL=INFO

# Application
APP_NAME=multi-agent-workflow
APP_PORT=8000
